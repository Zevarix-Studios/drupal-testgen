{
  "name": "drupal-testgen",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check src tests eslint.config.js tsconfig.json package.json .github/workflows docs/toolchain.md",
    "test": "npm run build && node --test 'dist/tests/*.test.js'",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@drupal/playwright": "1.2.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "6.0.2",
    "typescript-eslint": "8.70.0"
  }
}
